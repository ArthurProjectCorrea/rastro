{
  "$schema": "https://developers.cloudflare.com/workers/wrangler/config-schema.json",
  "name": "rastro-mockup",
  "compatibility_date": "2026-10-01",
  // Static assets only: nothing outside docs/mockup is ever uploaded
  "assets": {
    "directory": "./docs/mockup",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none",
  },
  // Public on workers.dev for now (Cloudflare Access is not enabled yet)
  "workers_dev": true,
  "preview_urls": false,
}
